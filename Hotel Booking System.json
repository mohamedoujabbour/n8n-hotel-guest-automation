    },
    {
      "parameters": {
        "sendTo": "={{ $('Switch').item.json.Email }}",
        "subject": "={{ $('Get Hotel Reservation').item.json['Guest Name'] }}, thank you for staying with US ⭐",
        "message": "=<p>Dear <strong>{{ $json['Guest Name'] }}</strong>,</p>\n\n<p>Thank you so much for staying with us recently in your <strong>{{ $json['Room Type'] }}</strong>. We truly hope you had a wonderful and memorable experience.</p>\n\n<p>Your feedback means the world to us and helps us constantly improve our service. If you have a spare minute, we would be incredibly grateful if you could share your experience with us or leave a review online:</p>\n\n<p style=\"text-align: center; margin: 25px 0;\">\n  <a href=\"https://g.page/your-hotel-review-link\" style=\"background-color: #4F46E5; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; font-weight: bold;\">Leave a Google Review</a>\n</p>\n\n<p>As a token of our appreciation for your next visit, enjoy a special <strong>10% off</strong> on your next direct booking by using the code: <code>THANKYOU10</code>.</p>\n\n<p>We hope to welcome you back again soon!</p>\n\n<p>Warm regards,<br>\n<strong>Hotel Management Team</strong></p>",
        "options": {
          "appendAttribution": false
        }
      },
