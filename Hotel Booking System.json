    {
      "parameters": {
        "sendTo": "={{ $('Switch').item.json.Email }}",
        "subject": "Welcome to Hotel - Your Stay Begins Soon! ",
        "message": "=<p>Dear <strong>{{ $json['Guest Name'] }}</strong>,</p>\n\n<p>Warm greetings from our hotel team! We are absolutely thrilled to welcome you for your upcoming stay in our <strong>{{ $json['Room Type'] }}</strong>.</p>\n\n<p>Here are a few quick details about your reservation:</p>\n<ul>\n  <li><strong>Reservation ID:</strong> {{ $json['Reservation ID'] }}</li>\n  <li><strong>Check-in Date:</strong> {{ $json['Check-in Date'] }}</li>\n  <li><strong>Check-out Date:</strong> {{ $json['Check-out Date'] }}</li>\n</ul>\n\n<p>If you have any special requests (like your noted preference: <em>{{ $json['Special Requests'] }}</em>) or need help arranging airport pickup or local tours around Marrakech, please don't hesitate to reply directly to this email.</p>\n\n<p>Safe travels, and see you very soon!</p>\n\n<p>Best regards,<br>\n<strong>Hotel Management Team</strong></p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "4fa06fe8-fa09-461f-b601-0c3f7cd8195e",
      "name": "Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "position": [
        1792,
        256
      ],
      "webhookId": "0ad03fe4-6be0-4c11-8087-9c62cfeab4b1",
      "typeVersion": 2.1,
